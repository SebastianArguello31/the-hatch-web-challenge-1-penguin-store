//- Estructura HTML compartida: metadatos, navegación, contenido y pie de página.
doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title #{title} | Penguin Store
    link(rel="stylesheet" href="/css/style.css")
  body
    header.navbar
      a.brand(href="/") Penguin Store
      nav
        a(href="/") Productos
    main.container
      block content
    footer.footer
      p Penguin Store · Challenge de Node.js